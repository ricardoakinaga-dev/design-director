{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ricardoakinaga-dev/design-director/benchmarks/schema/benchmark.schema.json",
  "title": "Design Director visual benchmark",
  "description": "Repository-relative contract for a visual benchmark brief and its acceptance bar.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "brief",
    "inputs",
    "references",
    "constraints",
    "viewports",
    "states",
    "regions",
    "expected_artifacts",
    "preservation_rules",
    "quality_threshold",
    "iteration_budget"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^B[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "category": {
      "type": "string",
      "enum": [
        "banner",
        "banners",
        "landing-page",
        "landing-pages",
        "dashboard",
        "dashboards",
        "mobile",
        "mobile-flows",
        "reconstruction",
        "screenshot-reconstruction",
        "product-brand",
        "product-ads",
        "game-ui"
      ]
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "surface", "acceptance_criteria"],
      "anyOf": [
        {"required": ["user"]},
        {"required": ["audience"]}
      ],
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "user": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"$ref": "#/$defs/brief-user"}
          ]
        },
        "surface": {"type": "string", "minLength": 1},
        "primary_action": {"type": "string", "minLength": 1},
        "content_context": {"type": "string", "minLength": 1},
        "context": {"type": "string", "minLength": 1},
        "success": {"type": "string", "minLength": 1},
        "success_criteria": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/input"}
    },
    "references": {
      "type": "array",
      "items": {"$ref": "#/$defs/reference"}
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "must_include", "must_avoid"],
      "properties": {
        "scope": {
          "type": "string",
          "enum": ["new", "greenfield", "existing", "reconstruction", "asset-preserving", "audit-only"]
        },
        "must_include": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "must_avoid": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "technology": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "accessibility": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "responsive": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "copy": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "array", "items": {"type": "string", "minLength": 1}},
            {"type": "object"}
          ]
        },
        "performance": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "product_specificity": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "array", "items": {"type": "string", "minLength": 1}},
            {"$ref": "#/$defs/product-specificity"}
          ]
        },
        "edit_vs_regenerate": {
          "oneOf": [
            {"type": "string", "enum": ["adaptive", "edit", "regenerate"]},
            {"$ref": "#/$defs/edit-vs-regenerate"}
          ]
        },
        "identity_lock": {"type": "object"},
        "reference_handling": {"type": "object"},
        "data_contract": {"type": "object"},
        "art_bible": {"type": "object"},
        "interaction": {"type": "object"},
        "copy_stress": {"type": "object"},
        "identity": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "medium": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      }
    },
    "viewports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/viewport"
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/state-string"},
          {"$ref": "#/$defs/state-object"}
        ]
      }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          {"$ref": "#/$defs/region"}
        ]
      }
    },
    "expected_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/expected-artifact"}
    },
    "preservation_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutable", "high_sensitivity", "flexible", "forbidden_inference"],
      "properties": {
        "immutable": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "high_sensitivity": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "flexible": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "forbidden_inference": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "quality_threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_min",
        "evidence_confidence_min",
        "require_independent_critic",
        "block_critical",
        "block_high"
      ],
      "properties": {
        "overall_min": {"type": "number", "minimum": 0, "maximum": 100},
        "min_score": {"type": "number", "minimum": 0, "maximum": 100},
        "score": {"type": "number", "minimum": 0, "maximum": 100},
        "aaa_min": {"type": "number", "minimum": 95, "maximum": 100},
        "evidence_confidence_min": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"]
        },
        "evidence_confidence": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"]
        },
        "require_independent_critic": {"type": "boolean"},
        "block_critical": {"type": "boolean"},
        "block_high": {"type": "boolean"},
        "critical_allowed": {"type": "integer", "minimum": 0},
        "high_open_allowed": {"type": "integer", "minimum": 0},
        "required_gates": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "applicable_dimensions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "critical_findings_allowed": {"type": "integer", "minimum": 0},
        "high_findings_allowed": {"type": "integer", "minimum": 0},
        "aaa_candidate": {"type": "object"}
      }
    },
    "iteration_budget": {
      "oneOf": [
        {"type": "integer", "minimum": 1, "maximum": 4},
        {"$ref": "#/$defs/iteration-budget"}
      ]
    }
  },
  "$defs": {
    "brief-user": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "context": {"type": "string", "minLength": 1},
        "need": {"type": "string", "minLength": 1},
        "skill_level": {"type": "string", "minLength": 1}
      },
      "minProperties": 1
    },
    "product-specificity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "test": {"type": "string", "minLength": 1},
        "must_feel_native": {"type": "boolean"},
        "signals": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "avoid_generic": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "minProperties": 1
    },
    "edit-vs-regenerate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"type": "string", "enum": ["adaptive", "edit", "regenerate"]},
        "prefer_edit_when": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "prefer_regenerate_when": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "iteration-budget": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {"required": ["max_cycles"]},
        {"required": ["max_iterations"]}
      ],
      "properties": {
        "max_cycles": {"type": "integer", "minimum": 1, "maximum": 4},
        "max_iterations": {"type": "integer", "minimum": 1, "maximum": 4},
        "tier": {"type": "string", "enum": ["trivial", "normal", "high-value", "explicit-high-fidelity"]},
        "stop_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "provenance": {
      "type": "string",
      "enum": [
        "source",
        "generated",
        "edited",
        "user-supplied",
        "repository-existing",
        "licensed",
        "unknown"
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "anyOf": [
        {"required": ["type", "source"]},
        {"required": ["id", "role", "kind", "provenance"]}
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "type": {"type": "string", "minLength": 1},
        "source": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"$ref": "#/$defs/input-source"}
          ]
        },
        "role": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/provenance"},
        "path": {"type": "string", "minLength": 1},
        "content": {"type": "string"},
        "description": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"}
      }
    },
    "input-source": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{"required": ["path"]}, {"required": ["content"]}, {"required": ["uri"]}],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "content": {"type": "string"},
        "uri": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "provenance"],
      "anyOf": [{"required": ["path"]}, {"required": ["uri"]}],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "role": {
          "type": "string",
          "enum": ["identity", "subject", "composition", "style", "lighting", "color", "material", "edit-target", "inspiration"]
        },
        "provenance": {"$ref": "#/$defs/provenance"},
        "path": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "width": {"type": "integer", "minimum": 240, "maximum": 7680},
        "height": {"type": "integer", "minimum": 320, "maximum": 4320},
        "device": {"type": "string", "minLength": 1},
        "orientation": {"type": "string", "enum": ["portrait", "landscape", "responsive"]},
        "dpr": {"type": "number", "minimum": 0.5, "maximum": 8},
        "route": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"}
      }
    },
    "state-string": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "state-object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "route": {"type": "string", "minLength": 1},
        "setup": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "expected": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "viewports": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "integer", "minimum": 240, "maximum": 7680},
              {"type": "string", "minLength": 1}
            ]
          }
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "viewports": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "integer", "minimum": 240, "maximum": 7680},
              {"type": "string", "minLength": 1}
            ]
          }
        },
        "states": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "expected-artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "role"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "kind": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "format": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "acceptance": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "coverage": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "regions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "checks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "notes": {"type": "string"}
      }
    }
  }
}
