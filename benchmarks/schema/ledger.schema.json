{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ricardoakinaga-dev/design-director/benchmarks/schema/ledger.schema.json",
  "title": "Visual regression ledger",
  "description": "Region-aware expected-versus-observed record for every tested viewport and state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "run_id", "entries"],
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "benchmark_id": {"type": "string", "pattern": "^B[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "width": {"type": "integer", "minimum": 240, "maximum": 7680},
          "height": {"type": "integer", "minimum": 320, "maximum": 4320},
        "device": {"type": "string", "minLength": 1},
        "orientation": {"type": "string", "enum": ["portrait", "landscape", "responsive"]},
        "dpr": {"type": "number", "minimum": 0.5, "maximum": 8},
        "route": {"type": "string", "minLength": 1}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "render_id",
        "region",
        "viewport",
        "state",
        "expected",
        "observed",
        "severity",
        "evidence",
        "fix",
        "status"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "render_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "region": {"type": "string", "minLength": 1},
        "viewport": {"$ref": "#/$defs/viewport"},
        "state": {"type": "string", "minLength": 1},
        "expected": {"type": "string", "minLength": 1},
        "observed": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "enum": ["critical", "high", "medium", "low", "polish"]},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "fix": {"type": "string"},
        "status": {"type": "string", "enum": ["open", "fixed", "accepted", "not-run", "blocked"]},
        "score": {"type": "number", "minimum": 0, "maximum": 100}
      }
    }
  }
}
